{
  "name": "async-csv",
  "version": "3.0.0",
  "description": "TypeScript / JavaScript async-await wrapper for the csv package.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test index.test.js && npm run test:types",
    "test:types": "tsc -p test/tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
