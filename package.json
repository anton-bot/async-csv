  ],
  "author": "Anton Ivanov <anton@ivanov.hk>",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/anton-bot/async-csv/issues"
  },
  "homepage": "https://github.com/anton-bot/async-csv#readme",
  "dependencies": {
    "csv": "^6.6.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^6.0.3"
  }
}
